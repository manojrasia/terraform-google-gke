project_id   = "your-gcp-project-id"
region       = "asia-south1"
cluster_name = "private-gke-cluster"

# Network ranges (change if they overlap with on-prem / other VPCs)
subnet_cidr      = "10.10.0.0/20"
pods_cidr        = "10.20.0.0/16"
services_cidr    = "10.30.0.0/20"
master_ipv4_cidr = "172.16.0.0/28"

# Fully internal control plane
enable_private_endpoint = true

# Add VPN / on-prem / Cloud Shell-free admin ranges here if needed
master_authorized_networks = [
  # { cidr_block = "192.168.0.0/16", display_name = "corp-vpn" },
]

machine_type       = "e2-standard-4"
min_nodes_per_zone = 1
max_nodes_per_zone = 3
use_spot           = false

create_bastion = true

# Example Workload Identity binding
workload_identity_bindings = {
  "app-gsa" = {
    namespace = "default"
    ksa_name  = "app-ksa"
    roles     = ["roles/storage.objectViewer"]
  }
}

labels = {
  env        = "dev"
  managed-by = "terraform"
}
